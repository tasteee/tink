{
	"name": "zesty-wc-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --port 5174",
		"dev:web": "vite",
		"dev:bridge": "pnpm --filter @tasteee/bridge dev",
		"dev:plot": "pnpm --filter @tasteee/plot dev",
		"build:plot": "pnpm --filter @tasteee/plot build",
		"dev:voxel": "pnpm --filter @tasteee/voxel dev",
		"build:voxel": "pnpm --filter @tasteee/voxel build",
		"dev:vink": "pnpm --filter @tasteee/vink dev",
		"build:vink": "pnpm --filter @tasteee/vink build",
		"build": "tsc --noEmit -p tsconfig.app.json && vite build && pnpm --filter @tasteee/plot build:site && pnpm --filter @tasteee/voxel build:site && pnpm --filter @tasteee/vink build:site",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.app.json"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@tasteee/zest": "github:tasteee/zest#main",
		"react": "^19",
		"react-dom": "^19",
		"wouter": "^3.10.0"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.7.0",
		"typescript": "^5.7.3",
		"vite": "^6.0.0"
	}
}
