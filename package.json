{
	"name": "zesty-wc-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @tasteee/zest exec vite build && concurrently -k -n lib,web -c blue,green \"pnpm --filter @tasteee/zest dev\" \"vite --port 5174\"",
		"dev:lib": "pnpm --filter @tasteee/zest dev",
		"dev:web": "vite",
		"dev:bridge": "pnpm --filter @tasteee/bridge dev",
		"dev:plot": "pnpm --filter @tasteee/plot dev",
		"build:plot": "pnpm --filter @tasteee/plot build",
		"build": "pnpm --filter @tasteee/zest build && tsc --noEmit -p tsconfig.app.json && vite build",
		"build:lib": "pnpm --filter @tasteee/zest build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.app.json"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@tasteee/zest": "workspace:*",
		"react": "^19",
		"react-dom": "^19",
		"wouter": "^3.10.0"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.7.0",
		"concurrently": "^10.0.3",
		"typescript": "^5.7.3",
		"vite": "^6.0.0"
	}
}
