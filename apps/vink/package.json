	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.0.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"vite": "^6.4.3"
	}
}
